# Copy this file to .env before running the app

# SQLite is used by default for easy local setup.
# Swap the provider in prisma/schema.prisma to "postgresql" for production.
DATABASE_URL="file:./dev.db"

# Long random string used to sign session tokens (JWT).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-this-to-a-long-random-string"

# Used to build "reset your password" links in the console-logged email stub.
APP_URL="http://localhost:3000"
