generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id               String    @id @default(cuid())
  memberId         String    @unique
  name             String
  username         String    @unique
  passwordHash     String
  role             String    @default("admin")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
}

model InventoryItem {
  id        String   @id @default(cuid())
  tagNumber String   @unique
  name      String
  database  String
  category  String
  quantity  Int      @default(0)
  unit      String?
  price     Float?
  supplier  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([database, category])
  @@index([name])
}

model Order {
  id            String    @id @default(cuid())
  customerName  String
  customerPhone String?
  status        String    @default("pending")
  channel       String    @default("whatsapp")
  summary       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  answeredAt    DateTime?
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model WhatsAppMessage {
  id          String    @id @default(cuid())
  fromNumber  String
  fromName    String?
  body        String
  direction   String    @default("inbound")
  status      String    @default("unanswered")
  receivedAt  DateTime  @default(now())
  answeredAt  DateTime?
  escalatedAt DateTime?
  orderId     String?
}

model Notification {
  id               String   @id @default(cuid())
  type             String
  message          String
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
  relatedMessageId String?
}

model Employee {
  id           String         @id @default(cuid())
  employeeCode String         @unique
  name         String
  role         String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  logs         DailyWorkLog[]
}

model DailyWorkLog {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  present     Boolean  @default(true)
  boardsCut   Int      @default(0)
  boardsEdged Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model CutlistRequest {
  id               String        @id @default(cuid())
  source           String        @default("manual")
  customerName     String?
  customerPhone    String?
  rawText          String
  status           String        @default("draft")
  confidence       Float?
  csvExportedAt    DateTime?
  confirmedAt      DateTime?
  rejectedAt       DateTime?
  relatedMessageId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            CutlistItem[]
}

model CutlistItem {
  id               String         @id @default(cuid())
  cutlistRequestId String
  cutlistRequest   CutlistRequest @relation(fields: [cutlistRequestId], references: [id], onDelete: Cascade)
  lengthMm         Float
  widthMm          Float
  thicknessMm      Float?
  quantity         Int            @default(1)
  material         String?
  edgingLongCount  Int            @default(0)
  edgingShortCount Int            @default(0)
  edgingLabel      String?
  notes            String?
}
